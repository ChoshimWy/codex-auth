# Copy to .env and fill in your credentials
#   cp Scripts/.env.example Scripts/.env
#
# CODE_SIGN_IDENTITY — find with: security find-identity -v -p codesigning
CODE_SIGN_IDENTITY="Developer ID Application: YOUR NAME (TEAMID)"
# NOTARY_PROFILE — set up with: xcrun notarytool store-credentials
NOTARY_PROFILE="CodexSwitcher"
